# PostPilot Environment Configuration

# Deployment environment ('development' | 'production')
ENVIRONMENT=development

# Server-side secret used to encrypt stored AI keys & OAuth tokens at rest using AES-GCM 256
# In production, generate with: openssl rand -base64 32
ENCRYPTION_KEY=postpilot-dev-encryption-key-32b!

# LinkedIn Developer App Credentials (Optional for local testing - Simulation Mode is built-in)
# Obtain from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/settings/linkedin/callback

# Optional Server-wide default AI Provider
# Individual users configure their own OpenAI-compatible endpoints directly in Settings > AI Provider
DEFAULT_AI_BASE_URL=https://api.openai.com/v1
DEFAULT_AI_API_KEY=
DEFAULT_AI_MODEL=gpt-4o
